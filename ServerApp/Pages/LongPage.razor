@page "/long"

<h1>Long Page</h1>

<button @onclick="@this.ScrollIntoViewByIdAsync">Scroll to bottom by ID</button>
<button @onclick="@this.ScrollIntoViewByElementAsync">Scroll to bottom by Element</button>
<p style="margin-bottom: 1400px">
    This is a very long page, that we use to test that the disconnected backdrop always covers the entire page, even if it is scrolled down a bit.
</p>

<p style="margin-bottom: 200px;" id="@this.BottomElementId" @ref="@this.BottomP">
    This paragraph should be way down below the previous one.
</p>
